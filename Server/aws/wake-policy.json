{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOnlyTheGameServer",
      "Effect": "Allow",
      "Action": "ec2:StartInstances",
      "Resource": "arn:aws:ec2:*:*:instance/PUT-YOUR-INSTANCE-ID-HERE"
    },
    {
      "Sid": "SeeWhetherItIsRunning",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
